# 기본: 텍스트 파일은 저장소에 LF로 저장, 체크아웃도 LF로
* text=auto eol=lf

# 리눅스(Docker)에서 실행되는 파일은 Windows에서도 반드시 LF
*.sh       text eol=lf
gradlew    text eol=lf
Dockerfile text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf

# Windows 전용 스크립트만 CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf

# 바이너리는 변환하지 않음
*.jar      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.zip      binary

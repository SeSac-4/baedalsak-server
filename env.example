# =============================================================================
# 로컬 개발용 환경 변수
#   cp .env.example .env   후 사용 (.env는 커밋 금지 — .gitignore 확인)
#   운영 값은 여기 두지 않습니다. 운영은 Secrets Manager에서 주입합니다.
# =============================================================================

# ---------- PostgreSQL ----------
DB_NAME=baedalsak
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=change-me-local
# 서비스별 계정(store_svc, order_svc ...)이 로컬에서 공통으로 쓰는 비밀번호
# (VSCode에서 envFile로 .env를 읽을 때 앱이 이 이름을 그대로 사용)
DB_PASSWORD=change-me-local

# ---------- RabbitMQ ----------
RABBITMQ_USER=baedalsak
RABBITMQ_PASSWORD=change-me-local

# ---------- Redis ----------
# ① 세션 관리용 (로컬 PC 접속: localhost:6379)
REDIS_SESSION_PASSWORD=change-me-local
# ② DB 캐시용 — 보류 (도입 시 주석 해제, 로컬 PC 접속: localhost:6380)
# REDIS_CACHE_PASSWORD=change-me-local

# ---------- 모듈 폴더 경로 (폴더 구조가 기본값과 다를 때만 수정) ----------
# 예: 서비스가 services/ 아래에 있으면 STORE_MODULE=services/store
# GATEWAY_MODULE=gateway
# STORE_MODULE=store
# ORDER_MODULE=order
# PAYMENT_MODULE=payment
# DELIVERY_MODULE=delivery
# NOTIFICATION_MODULE=notification
# USER_MODULE=user

# =============================================================================
# 로컬 개발용 환경 변수
#   cp .env.example .env   후 사용 (.env는 커밋 금지 — .gitignore 확인)
#   운영 값은 여기 두지 않습니다. 운영은 Secrets Manager에서 주입합니다.
# =============================================================================

# ---------- PostgreSQL (인스턴스 1개 · 서비스별 DB 5개) ----------
# 서비스 DB 이름(member, store, orders, payment, delivery)은 각 서비스 application.yml 기본값을 씀.
# DB_NAME 을 여기 쓰면 VSCode(envFile) 로 실행한 서비스가 전부 그 DB 로 붙으므로 주석으로 둠
#   (compose 의 postgres 관리자 기본 DB 이름 — 비우면 baedalsak)
# DB_NAME=baedalsak
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=change-me-local
# 서비스별 계정(member_svc, store_svc, order_svc ...)이 로컬에서 공통으로 쓰는 비밀번호
# (VSCode에서 envFile로 .env를 읽을 때 앱이 이 이름을 그대로 사용)
DB_PASSWORD=change-me-local

# ---------- RabbitMQ ----------
RABBITMQ_USER=baedalsak
RABBITMQ_PASSWORD=change-me-local

# ---------- Redis ----------
# ① 세션·토큰 관리용 (로컬 PC 접속: localhost:6379)
REDIS_SESSION_PASSWORD=change-me-local
# ② 캐시용 — delivery 실시간 위치 (로컬 PC 접속: localhost:6380, compose redis-cache)
REDIS_CACHE_PASSWORD=change-me-local

# ---------- Flyway seed (개발 환경 전용, #73) ----------
# 테이블(db/migration) + 개발용 고정 계정(db/seed/R__<서비스>_seed.sql)
# 기본값을 덮어쓰므로 db/migration 도 꼭 같이 적는다. 운영에는 이 값을 두지 않는다 → seed 미적용
SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# ---------- Cognito (member, #18) ----------
# 로컬 개발용 풀 baedalsak-local (팀 공용, 비밀값 아님). AWS 는 인프라가 주입
COGNITO_USER_POOL_ID=ap-northeast-2_8ObQTU0GH
COGNITO_CLIENT_ID=39p20ft9161anb9o4s08d38bpv
# gateway: 토큰 발급자(iss). JWKS 공개키 주소는 여기에 /.well-known/jwks.json 을 붙여 만든다 (#23)
COGNITO_ISSUER_URI=https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_8ObQTU0GH

# ---------- 가게·메뉴 사진 (store, #110) ----------
# 로컬도 AWS 와 같은 이미지 버킷에 올린다 (자격 증명은 본인 ~/.aws). 버킷 이름은 인프라에게 확인
# 조회는 CloudFront 로만 되므로 AWS 가 꺼져 있으면 로컬에서도 사진이 안 보인다
IMAGE_BUCKET=change-me-image-bucket
IMAGE_BASE_URL=https://baedalsak.click/images

# ---------- 메뉴 사진 배경 제거 AI 서버 (FastAPI, gateway 라우팅, #130) ----------
# 로컬에서 FastAPI 를 띄운 주소. 비우면 gateway 기본값 http://localhost:8000. AWS 는 인프라가 주입
AI_SERVICE_URL=http://localhost:8000

# ---------- Cognito seed 계정 비밀번호 (cognito-seed 프로필에서만 사용, #18) ----------
# Cognito 정책: 8자 이상, 영문 소문자 + 숫자 포함. 실제 값은 팀 메신저로 공유 (git 에 올리지 않음)
SEED_PASSWORD=change-me-seed1

# ---------- 비밀값 (운영: Secrets Manager → K8s Secret, N4.6) ----------
# 토스페이먼츠 시크릿 키 — payment. 테스트 키(test_sk_...)만 사용
TOSS_SECRET_KEY=test_sk_change-me

# 카카오 REST API 키 — delivery (주소 → 좌표, 길찾기). JS 키와 다른 키, 브라우저에 내보내지 않음
#   실제 값은 팀 메신저로 공유 (git 에 올리지 않음). 비우면 카카오 호출 없이 직선 경로로 대체
KAKAO_REST_API_KEY=change-me-kakao-rest-key
# 실시간 위치 출처: virtual(서버 가상 GPS, 기본) | real(라이더 앱 업로드)
# DELIVERY_GPS_MODE=virtual

# ---------- 모듈 폴더 경로 (폴더 구조가 기본값과 다를 때만 수정) ----------
# 예: 서비스가 services/ 아래에 있으면 STORE_MODULE=services/store
# GATEWAY_MODULE=gateway
# STORE_MODULE=store
# ORDER_MODULE=order
# PAYMENT_MODULE=payment
# DELIVERY_MODULE=delivery
# MEMBER_MODULE=member

SMS_SENDER=log
#문자를 로그로(테스트용)
